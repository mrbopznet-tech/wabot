# WhatsApp Bot - Environment Configuration Template
# Copy this file to .env and fill in your values

# Evolution API Configuration
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_INSTANCE_NAME=your-instance-name

# Docker Network Configuration
# Set this to match your Evolution API network name if different from default
EVOLUTION_NETWORK_NAME=evolution_network

# Bot Server Configuration
BOT_PORT=3000
BOT_WEBHOOK_PATH=/webhook

# Admin Configuration
# Super Admin Phone Numbers (comma separated, phone only without @s.whatsapp.net)
# These admins cannot be removed via commands
# Include both regular phone numbers AND @lid device IDs for multi-device support
# Example: 62881234567890,110157572870214
ADMINS=62882000300327,110157572870214

# Features
WELCOME_MESSAGE_ENABLED=true

# Blast Configuration
BLAST_USE_TYPING=false          # Disable typing indicator (not supported by Evolution API)
BLAST_MIN_DELAY=3000            # Minimum delay between messages in milliseconds (3 seconds)
BLAST_MAX_DELAY=8000            # Maximum delay between messages in milliseconds (8 seconds)
BLAST_MAX_TARGETS=50            # Maximum number of targets per blast session

# Security Configuration
# WEBHOOK_SECRET=your-secret-key-here  # Disabled for testing - uncomment for production
RATE_LIMIT_MAX_REQUESTS=10      # Maximum commands per user per window
RATE_LIMIT_WINDOW_MS=60000      # Rate limit window in milliseconds (60 seconds)
